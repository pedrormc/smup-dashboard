# ID da planilha Google Sheets (extraído da URL)
# Ex: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit
SMUP_SHEET_ID=1CZ4tfnyTcR9iFJujZhHa2aNHFajZc8zHdB21DEXgwfk

# GIDs das abas. Descubra rodando `mcp listSheets` ou olhando o gid na URL ao clicar em cada aba
SMUP_GID_NEGOCIOS=0
SMUP_GID_HISTORICO=1711054039
SMUP_GID_TAXAS=41696639

# Tempo de cache em segundos (ISR). Padrão 300 = 5 min
SMUP_REVALIDATE_SECONDS=300

# Token (string aleatória) para autorizar /api/revalidate. Use openssl rand -hex 32
REVALIDATE_TOKEN=changeme

# URL pública do site (Vercel preenche automaticamente em produção)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
